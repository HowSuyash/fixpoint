# Copy to .env and fill in. Only NEBIUS_API_KEY is required.

# Nebius Token Factory: https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily web search (optional, enables the research step): https://tavily.com
TAVILY_API_KEY=

# Model per tier. Run `fixpoint check` to confirm these IDs exist for your account.
FIXPOINT_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
FIXPOINT_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
FIXPOINT_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Where test runs execute: auto (Docker if the fixpoint-sandbox image exists), docker, or local.
FIXPOINT_SANDBOX=auto
FIXPOINT_TEST_COMMAND=python -m pytest -q -p no:cacheprovider
FIXPOINT_TEST_TIMEOUT=120

# Agent limits.
FIXPOINT_MAX_STEPS=24
FIXPOINT_ESCALATE_AFTER=3

# Web server only: allow cloning public git URLs / GitHub issue URLs (off by default on a public demo).
FIXPOINT_ALLOW_GIT_URLS=0
FIXPOINT_MAX_CONCURRENT_RUNS=2
